<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The nightly database backup on the Mac mini: `factory backup` at 03:30, run
  as the `SWFactory` user, keeping 14 daily copies in ~/.factory/backups. If
  the Mac mini is asleep at 03:30, launchd runs it when it wakes. Install it
  with the steps in docs/deploying.md#backups.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.factory.backup</string>

    <key>UserName</key>
    <string>SWFactory</string>
    <key>WorkingDirectory</key>
    <string>/Users/SWFactory</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/SWFactory/swfactory/orchestrator/.venv/bin/factory</string>
        <string>backup</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/SWFactory</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/SWFactory/.factory/backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/SWFactory/.factory/backup.log</string>
</dict>
</plist>
